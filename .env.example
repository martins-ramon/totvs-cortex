# Copie para .env e preencha localmente; na Vercel use Settings > Environment Variables.
# Não inclua credenciais reais no Git. Use o MESMO projeto Supabase para manter os dados.
DATABASE_URL=postgresql://postgres.PROJECT_REF:SENHA_URL_ENCODED@aws-0-REGIAO.pooler.supabase.com:6543/postgres?sslmode=require
OPENAI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Gere uma vez: python -c 'import secrets; print(secrets.token_hex(32))'
SESSION_SECRET=
ALLOWED_EMAILS=seu.email@totvs.com
# Vazio + ALLOWED_EMAILS preenchido restringe o acesso aos e-mails exatos acima.
ALLOWED_EMAIL_DOMAINS=
# Em produção substitua pela origem exata usada no navegador (sem caminho).
APP_BASE_URL=http://localhost:5000
# Na Vercel é false por padrão. Prepare o schema com python -m cortex.init_db.
# Localmente, sem esta variável, o schema é inicializado automaticamente.
AUTO_INIT_DB=false
